*.toml text eol=lf
# 模板清单是 Cargo.toml.tmpl，`*.toml` 盖不到它，单独列一条（见 scripts/domain-template/README.md）
*.tmpl text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
apps/vision-studio/ui/src/components/ui/*.tsx text eol=lf
apps/vision-studio/ui/src/shadcn-sources.json text eol=lf
apps/vision-studio/MICROSOFT-WEBVIEW2-LICENSE.txt -text

apps/asset-studio/MICROSOFT-WEBVIEW2-LICENSE.txt -text

lilyco-tauri/ui/src/components/ui/*.tsx text eol=lf
lilyco-tauri/ui/src/shadcn-sources.json text eol=lf
