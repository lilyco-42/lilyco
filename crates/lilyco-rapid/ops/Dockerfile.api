FROM rust:1.98-slim-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY core core
COPY server server
COPY ops/lilyco-no_std ops/lilyco-no_std
RUN cargo build --locked --release -p rapid-server

FROM debian:bookworm-slim
RUN groupadd -g 10001 rapid && useradd -u 10001 -g rapid --no-create-home rapid
WORKDIR /app
COPY --from=build /src/target/release/rapid-server /usr/local/bin/rapid-server
COPY Rapid.toml /app/Rapid.toml
RUN install -d -o rapid -g rapid /app/data
USER rapid
ENV RAPID_BIND=0.0.0.0:8421
EXPOSE 8421
ENTRYPOINT ["/usr/local/bin/rapid-server"]
