[package]
name = "@CRATE@"
version = "0.1.0"
edition = "2021"
description = "@BIN@ — <这个域回答什么问题>，四端 (CLI / TUI / Web / MCP) + AI 可调"
license = "MIT OR Apache-2.0"
repository = "https://github.com/Lyco-team/lilyco"
keywords = ["cli", "mcp"]
categories = ["command-line-interface", "development-tools"]

[[bin]]
name = "@BIN@"
path = "src/main.rs"

[dependencies]
# 默认独立可编译（无需处于 lilyco 父级 workspace 内）。
# Android/Termux 构建用 headless：--no-default-features --features android（纯 Rust CLI + MCP）。
lilyco = { git = "https://github.com/Lyco-team/lilyco.git", optional = true, default-features = false }
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[features]
default = ["full"]
# 全功能（CLI + TUI + Web + MCP）
full = ["dep:lilyco", "lilyco/full"]
# Android/Termux：headless（CLI + MCP）
android = ["dep:lilyco"]

[dev-dependencies]
tempfile = "3"

[package.metadata.binstall]
pkg-url = "https://github.com/Lyco-team/lilyco/releases/download/v{ version }/{ name }-{ target }{ binary-ext }"
pkg-fmt = "bin"
